#!/usr/bin/env python3
"""Keep the TV's CEC awake and turn the TV off when the Chromecast goes to standby.

Every INTERVAL seconds, over the Pi's HDMI CEC adapter, this asks the TV (address 0)
and the Chromecast (address 8) for their power status. The regular TV query is the
keep-awake. Each poll ends in a power state (on, standby, to-standby, to-on) or
"NOT ACCESSIBLE (<reason>)".

Shutdown drives the TV and soundbar together; wake drives the TV alone (the soundbar acted
oddly when woken alongside the TV, so it's left for you to turn on). Both are driven purely
by the Chromecast's state (the soundbar's own CEC status isn't polled, only sent to):

TV/soundbar shutdown: this TV ignores the CEC STANDBY frame the Chromecast sends, but
obeys the remote-control key "Power Off Function", sent directly to each device (a
broadcast of the same key does nothing on this TV). So when the Chromecast changes from
on to standby, and stays there for --delay seconds, and the TV is still on, the Pi sends
that key to the TV and the soundbar. It only reacts to that change, never to the
Chromecast merely sitting in standby, so watching another input is safe as long as the
Chromecast doesn't drop to standby on its own when you switch away (see the log after
testing that).

TV wake: when the Chromecast wakes (standby -> on) while the TV is in standby, the TV is
expected to turn on by itself, but in practice this Chromecast's own wake signal doesn't
reach the TV, so the Pi sends the explicit remote-control key "Power On Function" (the
counterpart of the off key, not a toggle) to the TV alone, almost immediately, retrying
every --wake-delay seconds until the TV answers. It does nothing if the TV comes on by
itself first. Testing found this key only reliably wakes the TV when it had gone to
standby recently (seconds ago); waking it after minutes in standby did not work in any of
several tries. Sending the same key to the soundbar at the same time also worked in that
same short-standby test, but was dropped after the soundbar was seen to behave oddly on a
real cast-and-reconnect, so waking the soundbar is left to you (or the TV's ARC, if it
turns the soundbar on by itself once the TV is on).

Usage: python3 tv-cec.py [-d /dev/cec1] [-i 3] [--delay 5] [--wake-delay 3] [--no-wake] [--dry-run]
Log:   stdout (journal under systemd) and ~/.local/share/tv-cec.log
"""
import argparse
import re
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

LOG_PATH = Path.home() / ".local" / "share" / "tv-cec.log"
TV, CHROMECAST, SOUNDBAR = 0, 8, 5
NAMES = {TV: "TV", CHROMECAST: "Chromecast", SOUNDBAR: "Soundbar"}
ASLEEP = {"standby", "to-standby"}
AWAKE = {"on", "to-on"}
HEARTBEAT_S = 60
COOLDOWN_S = 30
NA = "NOT ACCESSIBLE"

_log_file = None
_live_shown = False


def log(msg: str) -> None:
    global _live_shown
    line = f"{datetime.now():%Y-%m-%d %H:%M:%S} {msg}"
    if _live_shown:
        print("\r\033[K", end="")
        _live_shown = False
    print(line, flush=True)
    if _log_file:
        _log_file.write(line + "\n")
        _log_file.flush()


def cec(dev: str, *args: str) -> str:
    try:
        r = subprocess.run(["cec-ctl", "-d", dev, *args], capture_output=True,
                           text=True, timeout=15)
        return r.stdout + r.stderr
    except subprocess.TimeoutExpired:
        return "cec-ctl timed out"
    except OSError as e:
        return f"cec-ctl failed to run: {e}"


def hdmi_status(adapter_out: str) -> str:
    m = re.search(r"DRM Connector Info\s*:\s*card (\d+), connector (\d+)", adapter_out)
    if not m:
        return "unknown"
    card, conn_id = m.groups()
    for d in Path("/sys/class/drm").glob(f"card{card}-*"):
        try:
            if (d / "connector_id").read_text().strip() == conn_id:
                return (d / "status").read_text().strip()
        except OSError:
            pass
    return "unknown"


def diagnose(dev: str, fallback: str) -> str:
    out = cec(dev)
    if "Failed to open" in out or "No such file" in out:
        return "CEC device missing"
    if hdmi_status(out) == "disconnected":
        return "HDMI disconnected"
    pa = re.search(r"Physical Address\s*:\s*(\S+)", out)
    if pa and pa.group(1) == "f.f.f.f":
        return "no physical address"
    mask = re.search(r"Logical Address Mask\s*:\s*0x([0-9a-fA-F]+)", out)
    if mask and int(mask.group(1), 16) == 0:
        return "adapter unregistered"
    return fallback


def query(dev: str, addr: int) -> str:
    """A power state, or 'NOT ACCESSIBLE (reason)'."""
    out = cec(dev, "--to", str(addr), "--give-device-power-status")
    m = re.search(r"pwr-state:\s*(\S+)", out)
    if m:
        return m.group(1)
    if "Not Acknowledged" in out:
        reason = "no CEC ack"
    elif "Timeout" in out and "cec-ctl timed out" not in out:
        reason = "acked, no reply"
    else:
        last = [l.strip() for l in out.splitlines() if l.strip()]
        reason = "error: " + (last[-1] if last else "no output")
    return f"{NA} ({diagnose(dev, reason)})"


def register(dev: str) -> None:
    """(Re)claim a playback logical address. Never sends Active Source."""
    out = cec(dev, "--playback", "-o", "Pi-watch")
    m = re.search(r"Logical Address\s*:\s*(\d+)", out)
    log(f"registered on {dev}: logical address {m.group(1) if m else '?'}")


def adapter_info(dev: str) -> str:
    out = cec(dev)
    pa = re.search(r"Physical Address\s*:\s*(\S+)", out)
    mask = re.search(r"Logical Address Mask\s*:\s*(\S+)", out)
    return (f"phys={pa.group(1) if pa else '?'} mask={mask.group(1) if mask else '?'} "
            f"hdmi={hdmi_status(out)}")


def needs_register(dev: str) -> bool:
    mask = re.search(r"Logical Address Mask\s*:\s*0x([0-9a-fA-F]+)", cec(dev))
    return bool(mask) and int(mask.group(1), 16) == 0


def _press_release(dev: str, addr: int, ui_cmd: str) -> str:
    """Send a remote-control key directly to one device; 'acked' or the failure, from the press.

    Sent directly, never broadcast: a broadcast of the same key had no effect on the TV.
    """
    out = cec(dev, "--to", str(addr), "--user-control-pressed", f"ui-cmd={ui_cmd}")
    cec(dev, "--to", str(addr), "--user-control-released")
    if "Not Acknowledged" in out:
        return "NACK (not listening)"
    if "Failed" in out or "timed out" in out:
        return "error: " + out.strip().splitlines()[-1]
    return "acked"


def _press_release_all(dev: str, ui_cmd: str) -> str:
    """Send a remote-control key to the TV and the soundbar; both, individually addressed."""
    return ", ".join(f"{NAMES[a]}={_press_release(dev, a, ui_cmd)}" for a in (TV, SOUNDBAR))


def power_off_tv(dev: str) -> str:
    """Remote-control 'Power Off Function' key, to the TV and soundbar; this TV ignores plain STANDBY."""
    return _press_release_all(dev, "power-off-function")


def power_off_soundbar(dev: str) -> str:
    """Remote-control 'Power Off Function' key, to the soundbar alone."""
    return f"{NAMES[SOUNDBAR]}={_press_release(dev, SOUNDBAR, 'power-off-function')}"


def power_on_tv(dev: str) -> str:
    """Remote-control 'Power On Function' key, to the TV alone: an explicit on, not a toggle.

    Not sent to the soundbar: it behaved oddly (see log) when woken alongside the TV.
    """
    return f"{NAMES[TV]}={_press_release(dev, TV, 'power-on-function')}"


class WakeTrigger:
    """Fire when the Chromecast wakes but the TV stays in standby.

    Arms on Chromecast asleep -> awake while the TV is in standby; a Chromecast that wakes
    because the TV is already on never arms it. It fires almost at once (after FIRST_DELAY_S,
    just enough to ignore a blip) and then retries every --wake-delay seconds, MAX_ATTEMPTS
    in all. While the TV is unreachable (typically booting) it waits without firing.
    """

    FIRST_DELAY_S = 1.0
    MAX_ATTEMPTS = 20
    GIVE_UP_S = 60

    def __init__(self, delay: float):
        self.delay = delay
        self.cc_prev: str | None = None
        self.armed_at: float | None = None  # last fire, or arm time
        self.first_at = 0.0
        self.attempts = 0
        self.cooldown_until = 0.0

    def _disarm(self) -> None:
        self.armed_at = None

    def step(self, now: float, tv: str, cc: str) -> tuple[str | None, bool]:
        """Return (message, fire)."""
        msg, fire = None, False
        if self.armed_at is None:
            if (self.cc_prev in ASLEEP and cc in AWAKE and tv == "standby"
                    and now >= self.cooldown_until):
                self.armed_at = self.first_at = now
                self.attempts = 0
                msg = (f"Chromecast {self.cc_prev} -> {cc} with TV in standby: "
                       f"sending Power On in {self.FIRST_DELAY_S:g}s")
        else:
            waited = now - self.first_at
            if tv in AWAKE:
                sent = f", after {self.attempts} Power On" if self.attempts else ", by itself"
                msg = f"TV is {tv} {waited:.0f}s after the Chromecast woke{sent}"
                self._disarm()
            elif cc in ASLEEP:
                msg = f"Chromecast is {cc} again: wake cancelled"
                self._disarm()
            elif waited > self.GIVE_UP_S:
                msg = f"TV still {tv} {waited:.0f}s after the Chromecast woke: giving up"
                self._disarm()
                self.cooldown_until = now + COOLDOWN_S
            elif tv == "standby" and now - self.armed_at >= (
                    self.FIRST_DELAY_S if self.attempts == 0 else self.delay):
                self.attempts += 1
                fire = True
                msg = (f"TV still in standby {waited:.0f}s after the Chromecast woke: "
                       f"Power On attempt {self.attempts}/{self.MAX_ATTEMPTS}")
                self.armed_at = now
                if self.attempts >= self.MAX_ATTEMPTS:
                    self._disarm()
                    self.cooldown_until = now + COOLDOWN_S
        if not cc.startswith(NA):
            self.cc_prev = cc
        return msg, fire


class Trigger:
    """Fire in two stages when the Chromecast goes awake -> asleep while the TV is on.

    Sending Power Off to the TV and soundbar at the same moment left the soundbar still
    on (it acks the key but doesn't act on it fast enough), so the soundbar now gets a
    head start: at half of --delay it's sent alone, then at the full --delay the TV and
    soundbar are sent together (a harmless second nudge to the soundbar). Cancels if the
    Chromecast wakes back up before the final stage.

    step() returns (message, action), action one of None, "soundbar_off", "power_off".
    Time is passed in so this is testable.
    """

    def __init__(self, delay: float):
        self.delay = delay
        self.lead = delay / 2
        self.cc_prev: str | None = None
        self.armed_at: float | None = None
        self.soundbar_sent = False
        self.cooldown_until = 0.0

    def step(self, now: float, tv: str, cc: str) -> tuple[str | None, str | None]:
        """Return (message, action)."""
        msg, action = None, None
        if self.cc_prev in AWAKE and cc in ASLEEP and now >= self.cooldown_until:
            if tv == "on":
                self.armed_at = now
                self.soundbar_sent = False
                msg = f"Chromecast {self.cc_prev} -> {cc} with TV on: waiting {self.delay:g}s"
            else:
                msg = f"Chromecast {self.cc_prev} -> {cc} but TV is {tv}: nothing to do"
        elif self.armed_at is not None and cc in AWAKE:
            self.armed_at = None
            msg = f"Chromecast is {cc} again: cancelled"
        # A transient NOT ACCESSIBLE (common CEC blip) neither arms nor cancels: only a
        # real on<->off transition does. The pending timer just keeps waiting through it.
        self.cc_prev = cc if not cc.startswith(NA) else self.cc_prev

        if self.armed_at is not None:
            waited = now - self.armed_at
            if waited >= self.delay:
                self.armed_at = None
                if tv == "on":
                    self.cooldown_until = now + COOLDOWN_S
                    action = "power_off"
                    msg = f"Chromecast still {cc} and TV still on: turning TV off"
                else:
                    msg = f"TV is {tv} now: not sending power-off"
            elif not self.soundbar_sent and waited >= self.lead and tv == "on":
                self.soundbar_sent = True
                action = "soundbar_off"
                msg = f"{waited:.0f}s in: turning soundbar off first, TV follows at {self.delay:g}s"
        return msg, action


def main() -> None:
    global _log_file, _live_shown
    ap = argparse.ArgumentParser()
    ap.add_argument("-d", "--device", default="/dev/cec1")
    ap.add_argument("-i", "--interval", type=float, default=1.0)
    ap.add_argument("--delay", type=float, default=5.0,
                    help="seconds the Chromecast must stay in standby before the TV is turned off")
    ap.add_argument("--wake-delay", type=float, default=1.0,
                    help="seconds between Power On retries once the TV is confirmed still asleep")
    ap.add_argument("--no-wake", action="store_true", help="never send Power On to the TV")
    ap.add_argument("--dry-run", action="store_true", help="log what would be sent, send nothing")
    args = ap.parse_args()
    dev = args.device

    _log_file = open(LOG_PATH, "a")
    log(f"start: dev={dev} interval={args.interval:g}s delay={args.delay:g}s "
        f"wake={'off' if args.no_wake else f'{args.wake_delay:g}s'} "
        f"dry_run={args.dry_run} ({adapter_info(dev)})")
    if needs_register(dev):
        register(dev)

    trigger = Trigger(args.delay)
    wake = None if args.no_wake else WakeTrigger(args.wake_delay)
    last: dict[int, str] = {}
    since: dict[int, float] = {}
    polls = 0
    next_beat = time.monotonic() + HEARTBEAT_S
    next_poll = time.monotonic()
    try:
        while True:
            now = time.monotonic()
            states = {addr: query(dev, addr) for addr in (TV, CHROMECAST)}
            polls += 1
            if any("adapter unregistered" in s for s in states.values()):
                register(dev)

            for addr, st in states.items():
                if last.get(addr) != st:
                    dur = f" (was {last[addr]} for {now - since[addr]:.0f}s)" if addr in last else ""
                    log(f"{NAMES[addr]}: {st}{dur}")
                    last[addr] = st
                    since[addr] = now

            msg, action = trigger.step(now, states[TV], states[CHROMECAST])
            if msg:
                log(msg)
            if action == "soundbar_off":
                if args.dry_run:
                    log("DRY RUN: would send Power Off Function to Soundbar (lead-in)")
                else:
                    res = power_off_soundbar(dev)
                    log(f"sent Power Off Function (lead-in): {res}")
            elif action == "power_off":
                if args.dry_run:
                    log("DRY RUN: would send Power Off Function to TV+Soundbar")
                else:
                    res = power_off_tv(dev)
                    log(f"sent Power Off Function: {res}")

            if wake:
                msg, fire = wake.step(now, states[TV], states[CHROMECAST])
                if msg:
                    log(msg)
                if fire:
                    if args.dry_run:
                        log("DRY RUN: would send Power On Function to TV")
                    else:
                        res = power_on_tv(dev)
                        log(f"sent Power On Function: {res}")

            if sys.stdout.isatty():
                parts = " | ".join(f"{NAMES[a]} {v} ({now - since[a]:.0f}s)" for a, v in last.items())
                print(f"\r\033[K{datetime.now():%H:%M:%S} {parts}", end="", flush=True)
                _live_shown = True

            if now >= next_beat:
                log("heartbeat: " + " ".join(f"{NAMES[a]}={v}" for a, v in last.items())
                    + f" polls={polls} ({adapter_info(dev)})")
                next_beat = now + HEARTBEAT_S

            next_poll += args.interval
            time.sleep(max(0.0, next_poll - time.monotonic()))
            if next_poll < time.monotonic() - 5:
                next_poll = time.monotonic()
    except KeyboardInterrupt:
        log(f"stopped after {polls} polls")


if __name__ == "__main__":
    sys.exit(main())
