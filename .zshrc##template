function gitrmgone() {
    # source: https://stackoverflow.com/a/33548037/1731824
    git fetch -p
    GONE_BRANCHES=$(git for-each-ref --format '%(refname) %(upstream:track)' refs/heads | awk '$2 == "[gone]" {sub("refs/heads/", "", $1); print $1}')
    if [ -z "$GONE_BRANCHES" ]
    then
        echo "No remote branches are gone"
        return
    fi
    echo "The following commands will be run :"
    for branch in $(echo $GONE_BRANCHES); do
        echo "- git branch -D $branch;"
    done
    echo -n "Are you sure? (Y/N) "
    read REPLY
    if [[ $REPLY =~ ^[Yy]$ ]]
    then
        for branch in $(echo $GONE_BRANCHES); do
            git branch -D $branch;
        done
    else
        echo "Cancelled"
    fi
}

gitmain() {
    CURRENT_BRANCH=$(git symbolic-ref --short HEAD)
    MAIN_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')

    if [ "$CURRENT_BRANCH" = "$MAIN_BRANCH" ]; then
        git pull
        return
    fi

    git fetch
    git fetch origin $MAIN_BRANCH:$MAIN_BRANCH
    git switch $MAIN_BRANCH
}

gitrbas() {
    MAIN_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')
    BRANCH=$(echo "${1:-origin/$MAIN_BRANCH}")

    # enable flag to show commands being run
    set -x

    # rebase with autosquash
    git rebase --autosquash $BRANCH
}
compdef _git gitrbas=git-rebase

