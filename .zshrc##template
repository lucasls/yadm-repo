# MacOS Functions
function keychain-set() {
    security add-generic-password -a "$USER" -s "$1" -w "$2" -U
}

function keychain-get() {
    security find-generic-password -a "$USER" -s "$1" -w
}

function notify() {
    local exit_status=$?
    if [[ $# -gt 0 ]]; then
        "$@"
        exit_status=$?
    fi
    local subtitle
    if [[ $exit_status -eq 0 ]]; then
        subtitle="Done"
    else
        subtitle="Failed ($exit_status)"
    fi
    osascript -e "display notification \"${*:-Command finished}\" with title \"Terminal\" subtitle \"$subtitle\" sound name \"Glass\""
    return $exit_status
}
